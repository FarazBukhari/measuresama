<?xml version="1.0" encoding="utf-8"?>
<!--
    Big round + button. Tape yellow with an ink + once the circle is on a surface (activated);
    a see-through grey until then. It stays tappable either way, so a tap can be explained.
    The white ring keeps it visible over any camera picture.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33141414">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="oval">
                    <solid android:color="#FFC629" />
                    <stroke
                        android:width="3dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#66FFFFFF" />
                    <stroke
                        android:width="3dp"
                        android:color="#B3FFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
