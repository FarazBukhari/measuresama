<?xml version="1.0" encoding="utf-8"?>
<!--
    AR measuring screen: camera (GLSurfaceView), 2D overlay (reticle, points, lines, labels),
    a top bar (Close, hint; mode chip, warning, Clear) and a bottom bar (Undo, Add point, Save).
    Every touch target is at least 48dp. Bar paddings for system bars are added in code.
    The root FrameLayout stays (not <merge>): it carries keepScreenOn and the insets listener.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    tools:context=".ar.ArMeasureActivity"
    tools:ignore="MergeRootFrame">

    <android.opengl.GLSurfaceView
        android:id="@+id/ar_gl_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <com.foxysama.measuresama.ar.MeasureOverlayView
        android:id="@+id/ar_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:contentDescription="@string/ar_view_description"
        android:focusable="true" />

    <com.foxysama.measuresama.ar.ScanAnimationView
        android:id="@+id/ar_scan"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/ar_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/ar_close"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_ar_round"
                android:contentDescription="@string/ar_close"
                android:src="@drawable/ic_ar_close" />

            <TextView
                android:id="@+id/ar_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_ar_hint"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="@string/ar_hint_getting_ready"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ar_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_ar_hint"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="@string/ar_mode_area" />

            <TextView
                android:id="@+id/ar_warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_ar_warning"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:textColor="#1E1B4B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="invisible"
                tools:text="@string/ar_warning_far_metric"
                tools:visibility="visible" />

            <Button
                android:id="@+id/ar_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ar_control"
                android:minWidth="88dp"
                android:minHeight="48dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/ar_clear"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ar_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/ar_undo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_ar_control"
            android:minHeight="56dp"
            android:text="@string/ar_undo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/ar_add"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_ar_add"
            android:contentDescription="@string/ar_add_point"
            android:src="@drawable/ic_ar_add" />

        <Button
            android:id="@+id/ar_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_ar_primary"
            android:minHeight="56dp"
            android:text="@string/ar_save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
